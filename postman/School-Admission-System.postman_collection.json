      "item": [
        {
          "name": "00 - Health check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('health payload is ok', () => pm.expect(body.status).to.eql('ok'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          }
        }
      ]
    },
    {
      "name": "01 - Admin: classes",
      "item": [
        {
          "name": "01 - Create class (2 seats)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('className', 'Postman Class ' + Date.now());",
                  "pm.collectionVariables.set('capacityClassName', 'Postman Capacity ' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('response contains required fields', () => {",
                  "  pm.expect(body.id).to.be.a('string');",
                  "  pm.expect(body.id.length).to.be.above(0);",
                  "  pm.expect(body.name).to.eql(pm.variables.get('className'));",
                  "  pm.expect(body.totalSeats).to.eql(2);",
                  "});",
                  "pm.collectionVariables.set('classId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/classes",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{className}}\",\n  \"totalSeats\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "02 - List classes",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "const id = pm.variables.get('classId');",
                  "const found = body.find((c) => c.id === id);",
                  "pm.test('created class is listed', () => pm.expect(found).to.be.an('object'));",
                  "pm.test('seat count fields are present', () => {",
                  "  pm.expect(found.totalSeats).to.eql(2);",
                  "  pm.expect(found.heldSeats).to.eql(0);",
                  "  pm.expect(found.confirmedSeats).to.eql(0);",
                  "  pm.expect(found.availableSeats).to.eql(2);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/classes"
          }
        },
        {
          "name": "03 - Get class by id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('class payload matches', () => {",
                  "  pm.expect(body.id).to.eql(pm.variables.get('classId'));",
                  "  pm.expect(body.availableSeats).to.eql(2);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/classes/{{classId}}"
          }
        }
      ]
    },
